# Application Configuration
APP_NAME="Global Rental Car"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Docker Container Ports
FRONTEND_PORT=3000
BACKEND_PORT=8000
AI_PORT=5000
DB_PORT=5432

# Database Configuration
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=globalrental
DB_USERNAME=grader
DB_PASSWORD=

# Internal Service Inter-communication
AI_SERVICE_URL=http://ai_service:5000

# CORS: origins allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Sanctum: token prefix so secret scanners can detect leaked tokens
SANCTUM_TOKEN_PREFIX=grcm_

# Sanctum: token lifetime in minutes (1440 = 24 h)
SANCTUM_TOKEN_EXPIRATION=1440
