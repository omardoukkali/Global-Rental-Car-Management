APP_NAME="Global Rental Car"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Must stay in sync with the backend service in docker-compose.yml.
# `php artisan serve` spawns a child process that does not inherit the
# container environment, so Laravel reads these from this file, not compose.
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=globalrental
DB_USERNAME=grader
DB_PASSWORD=secret

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

AI_SERVICE_URL=http://ai_service:5000
# CORS: origins allowed to call the API (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3333

# Sanctum: token prefix so secret scanners can detect leaked tokens
SANCTUM_TOKEN_PREFIX=grcm_

# Sanctum: token lifetime in minutes (1440 = 24 h)
SANCTUM_TOKEN_EXPIRATION=1440

# Frontend URL used in e-mail links (password reset)
FRONTEND_URL=http://localhost:3000

# Mail (log = written to storage/logs/laravel.log; smtp = real e-mails)
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@globalrental.local
MAIL_FROM_NAME="Global Rental Car"
